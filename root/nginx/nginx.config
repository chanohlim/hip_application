events {}

http {
    server {
        listen 80;

        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri /index.html;
        }

        location /api/ {
            proxy_pass http://springboot:8080/;
        }

        location /pyapi/ {
            proxy_pass http://fastapi:8000/;
        }
    }
}